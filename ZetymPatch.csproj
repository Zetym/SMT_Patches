<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ZetymPatch</AssemblyName>
    <Product>ZetymPatch</Product>
    <Version Condition="'$(VERSION)' == ''">0.0.1</Version>
    <Version Condition="$(VERSION.StartsWith('v'))">$(VERSION.TrimStart("v"))</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>ZetymPatch</RootNamespace>
<!--    <SteamDir>/media/data/SteamLibrary</SteamDir> -->
    <GameDir>$(STEAM_DIR)/steamapps/common/Supermarket Together</GameDir>
    <GameManagedDir>$(GameDir)/Supermarket Together_Data/Managed</GameManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2023.2.22" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
	<Reference Include="Assembly-CSharp">
		<HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath>
	</Reference>
	<Reference Include="Mirror">
		<HintPath>$(GameManagedDir)/Mirror.dll</HintPath>
	</Reference>
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
